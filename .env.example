HTTP_ADDR=:8080
DATA_DIR=./data
CHEM_WORKER_URL=http://127.0.0.1:8000
REDIS_ADDR=127.0.0.1:6379

# Локально (Bonsai 2 27B / Ollama >= 0.40.6):
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=bonsai-2:27b
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=900
LLM_KEEP_ALIVE=30m
LLM_MAX_RPM=5
LLM_MAX_RETRIES=2
LLM_REASONING_EFFORT=low

# Опционально заточенный Modelfile:
# ollama create bonsai-mapper -f ops/Modelfile.bonsai-mapper
# LLM_MODEL=bonsai-mapper

# Облако OpenRouter (если локалка недоступна):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# LLM_HTTP_PROXY=http://127.0.0.1:10809
# OPENROUTER_API_KEY=
# LLM_TIMEOUT_S=90

OPENROUTER_API_KEY=
GEMINI_API_KEY=

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=atom-mapper
MINIO_SECURE=false
